# Copier en .env et remplir. Ne JAMAIS commiter le fichier .env.

# Nom de domaine définitif : il est gravé dans les cartes NTAG 424 DNA.
# edu.abmcy.com = domaine public vu du navigateur (Cloudflare Pages + Worker).
# L'API elle-même répond sur edu-api.abmcy.com (interne, voir
# deploy/diarra-vps.Caddyfile.snippet) : DOMAIN reste le domaine PUBLIC,
# utilisé pour EDUPILOT_PUBLIC_URL et les liens signés des cartes NFC.
DOMAIN=edu.abmcy.com
ACME_EMAIL=admin@abmcy.com

# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32   (scellement des secrets de portes, jetons signés)
EDUPILOT_SECRET_KEY=
# openssl rand -hex 16   (clé maître des cartes : à sauvegarder HORS LIGNE, en deux exemplaires)
EDUPILOT_CARD_MASTER_KEY=

# Premier compte administrateur (créé seulement s'il n'existe aucun admin)
EDUPILOT_BOOTSTRAP_ADMIN_EMAIL=admin@example.sn
EDUPILOT_BOOTSTRAP_ADMIN_PASSWORD=

EDUPILOT_TZ=Africa/Dakar
KAFKA_TOPIC_PARTITIONS=12
